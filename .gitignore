# Portfolio-root ignores (applies to all days; each day folder also has its
# own .gitignore). Small data files ARE committed — see AGENTS.md
# "Data-commit rule": .gitignore must never exclude data/.
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.venv/
venv/
.env
.env.*
*.pem
*.key
credentials*
.DS_Store
*.log
